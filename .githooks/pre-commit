#!/bin/sh
# Refuses a commit that adds or modifies a file under a protected path,
# including files forced in with "git add -f". Deleting them stays allowed.
. "$(dirname "$0")/protected-paths"

# shellcheck disable=SC2086
staged=$(git diff --cached --name-only --diff-filter=d -- $PROTECTED_PATHS)
if [ -n "$staged" ]; then
    echo "Commit refused: these files are under a protected path and must not be versioned:" >&2
    echo "$staged" | sed 's/^/  /' >&2
    echo "Unstage them with: git restore --staged <file>" >&2
    exit 1
fi

# Refuses a commit whose staged changes contain a secret (private key, API token, etc.).
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "Commit refused: gitleaks is required to check staged changes for secrets." >&2
    echo "It is installed in the claude dev container; elsewhere, see https://github.com/gitleaks/gitleaks#installing" >&2
    exit 1
fi
if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose --log-level warn; then
    echo "Commit refused: gitleaks found secrets in the staged changes (see above)." >&2
    echo "If a finding is a false positive, add its fingerprint to .gitleaksignore." >&2
    exit 1
fi
